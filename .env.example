# Copy this file to .env and fill in your real keys
# Groq: free key at https://console.groq.com/keys
# Pinecone: free key at https://app.pinecone.io (API Keys section)

GROQ_API_KEY=your-key-here
PINECONE_API_KEY=your-key-here

# Optional tuning (defaults shown)
# GROQ_MODEL=openai/gpt-oss-120b         # writes the answers
# GROQ_FAST_MODEL=openai/gpt-oss-20b     # query rewriting + reranking
# GROQ_JUDGE_MODEL=qwen/qwen3.8-27b      # grades answers in evals/
# RETRIEVAL_MODE=hybrid                  # dense | keyword | hybrid
# RERANKER=llm                           # llm | pinecone | none
# GROQ_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m   # prompt-injection classifier
# INJECTION_THRESHOLD=0.9                # block when the guard's score is at least this
# RATE_LIMIT_PER_MINUTE=8                # per client IP
# RATE_LIMIT_PER_DAY=150                 # per client IP
# GROQ_DAILY_TOKEN_LIMIT=200000          # per-model free quota, shown on /stats
