# Secrets - never commit your real API key
.env

# Python environment
venv/
__pycache__/
*.pyc

# Your personal documents - these are your own notes/PDFs, not meant
# to be public. Keep the folder structure but not the actual files.
data/*
!data/.gitkeep

# Chroma's local vector database - this is generated from data/, not
# source code, and can be large. Anyone cloning the repo regenerates
# it by running ingest.py + embed_store.py on their own documents.
storage/*
!storage/.gitkeep

# OS clutter
.DS_Store
Thumbs.db
