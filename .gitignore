# Secrets - never commit your real API key
.env

# Python environment
venv/
__pycache__/
*.pyc

# data/ is now committed - it holds public, MIT-licensed FastAPI
# documentation (from github.com/tiangolo/fastapi), safe to redistribute.
# storage/ (the generated vector index) still stays out of git - the
# app rebuilds it automatically from data/ on first startup (see api.py).
storage/*
!storage/.gitkeep

# OS clutter
.DS_Store
Thumbs.db
.venv/
